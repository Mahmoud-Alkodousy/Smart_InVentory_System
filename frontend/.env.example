# ════════════════════════════════════════════════════════════════════
#  Smart Inventory Manager — Frontend Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
#
#  NOTE: Vite only exposes variables prefixed with VITE_ to client code,
#  and they're baked in at BUILD time, not read at container runtime.
#  See the Dockerfile for how this is handled in the Docker build.
# ════════════════════════════════════════════════════════════════════

# Backend base URL. Leave empty for same-origin (e.g. when nginx proxies
# /api to the backend container).
VITE_API_URL=http://localhost:8000

# Only needed if the backend has API_KEYS configured (auth enabled).
VITE_API_KEY=
